# ============================================================================
# CAMPUSHIRE – ENVIRONMENT VARIABLES (.env.example)
# ============================================================================

# 1. SERVER CONFIGURATION
# Port on which the Express backend + Vite middleware server runs (Default: 3000)
PORT=3000
NODE_ENV=development

# 2. DATABASE CONFIGURATION (MongoDB + Mongoose)
# Connection string for MongoDB Atlas or local MongoDB instance.
# Used in: server/config/db.js
MONGO_URI="mongodb://127.0.0.1:27017/campushire_db"

# 3. AUTHENTICATION & SECURITY (JWT)
# Secret key used to sign and verify JSON Web Tokens.
# Used in: server/controllers/authController.js, server/middleware/authMiddleware.js
JWT_SECRET="replace_with_a_strong_64_char_random_hex_secret_in_production"
JWT_EXPIRE="7d"

# 4. CORS & CLIENT ORIGIN
# Frontend origin URL permitted by CORS policy.
# Used in: server/app.js
CLIENT_URL="http://localhost:3000"

# 5. CLOUDINARY CONFIGURATION (Optional - Resume PDF Storage)
# Used when storing student PDF resumes in cloud object storage.
# Falls back to local /uploads/resumes storage if omitted.
# Used in: server/middleware/uploadMiddleware.js, server/controllers/studentController.js
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# 6. EMAIL NOTIFICATION SERVICE (Optional - Nodemailer SMTP)
# Used to dispatch transactional emails on application submission, shortlisting,
# interview scheduling, and offer selection. Fails open gracefully if omitted.
# Used in: server/services/emailService.js
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER=""
EMAIL_PASSWORD=""
EMAIL_FROM="CampusHire Placement Cell <noreply@campushire.edu>"

# 7. REDIS CACHE CONFIGURATION (Optional - Performance Caching)
# Used for caching frequently queried job listings and admin analytics dashboards.
# Fails open to an in-memory TTL cache if Redis is unavailable.
# Used in: server/config/redis.js
REDIS_URL=""
